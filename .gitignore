# Python environments and dependency caches
.venv/
.uv-cache/
.pixi/

# Python bytecode, test, type-check, and coverage caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.hypothesis/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
pytestdebug.log

# Python package build products
build/
dist/
*.egg-info/

# Skill-local Pixi runtime data. env/pixi.toml and env/pixi.lock stay tracked.
.claude/skills/*/env/.pixi/
.claude/skills/*/env/cache/
.claude/skills/*/env/config/
.claude/skills/*/env/data/
.claude/skills/*/env/state/
.claude/skills/*/env/tmp/
.claude/skills/*/env/pixi-home/
.claude/skills/*/env/.environment-ready
.claude/skills/*/env/.bootstrap.lock

# Generated CONDUCTOR results and archived working data
/Archive/
/CONDUCTOR_modules/Archive/
results/
outputs/*
!outputs/.gitkeep
descriptions/
groups/
analysis/

# Repository-local smoke tests and temporary validation environments
.smoke-*/
.validation-site/

# OS, editor, and Office temporary files
.DS_Store
Thumbs.db
Desktop.ini
~$*
*.swp
*.swo
