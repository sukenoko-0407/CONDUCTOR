{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/interpretation_exploration_plan.schema.json",
  "title": "CONDUCTOR v4 interpretation exploration plan",
  "type": "object",
  "required": ["schema_version", "policy_version", "run_id", "source_interpretation_id", "iteration", "seed", "mode", "bounds", "discoveries", "requests", "unselected_candidates", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_interpretation_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer", "minimum": 0},
    "mode": {"enum": ["autonomous", "orchestrator-bounded"]},
    "bounds": {
      "type": "object",
      "properties": {
        "group_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "description_ids": {"type": "array", "items": {"type": "string", "pattern": "^D[0-9]{3}$"}, "uniqueItems": true},
        "grouping_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{3}$"}, "uniqueItems": true},
        "operator_ids": {"type": "array", "items": {"type": "string", "pattern": "^A[0-9]{3}$"}, "uniqueItems": true},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["discovery_id", "observation", "evidence_ids", "status", "falsification_required"],
        "properties": {
          "discovery_id": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "status": {"enum": ["discovery", "validation", "contradicted", "unresolved"]},
          "falsification_required": {"const": true}
        },
        "additionalProperties": true
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["request_id", "purpose", "capability_id", "depends_on", "parameters", "parent_discovery_ids", "expected_information_gain", "selection_reason"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["characterize", "falsify", "control", "replicate"]},
          "capability_id": {"type": "string", "pattern": "^[DCA][0-9]{3}$"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "parameters": {"type": "object"},
          "scope": {
            "type": "object",
            "required": ["scope_id", "mode", "selection_method", "target_compound_ids"],
            "properties": {
              "scope_id": {"type": "string", "minLength": 1},
              "mode": {"enum": ["within-group", "between-groups"]},
              "selection_method": {"enum": ["explicit", "random", "matched_random", "intersection", "difference", "boundary"]},
              "id_column": {"type": "string", "minLength": 1},
              "target_group_id": {"type": "string", "minLength": 1},
              "comparison_group_id": {"type": "string", "minLength": 1},
              "target_compound_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "minItems": 1,
                "uniqueItems": true
              },
              "comparison_compound_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "source_group_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "selection_notes": {"type": "string"}
            },
            "allOf": [
              {
                "if": {"properties": {"mode": {"const": "between-groups"}}},
                "then": {
                  "required": ["comparison_group_id", "comparison_compound_ids"],
                  "properties": {"comparison_compound_ids": {"minItems": 1}}
                }
              }
            ],
            "additionalProperties": false
          },
          "parent_discovery_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "expected_information_gain": {"type": "string", "minLength": 1},
          "selection_reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "unselected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "reason_not_selected"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "reason_not_selected": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
