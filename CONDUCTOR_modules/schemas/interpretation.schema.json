{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/interpretation.schema.json",
  "title": "CONDUCTOR interpretation",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "run_id",
    "interpretation_id",
    "report_status",
    "agent_review",
    "report_summary",
    "evidence_index",
    "evidence_relations",
    "unresolved_contradictions",
    "contradiction_assessment",
    "exploration_summary",
    "notable_findings",
    "hypotheses",
    "recommended_next_analysis",
    "human_review_points",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "policy_version": {"const": "1.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "interpretation_id": {"type": "string", "minLength": 1},
    "report_status": {"enum": ["draft", "agent_interpreted"]},
    "agent_review": {
      "type": "object",
      "required": ["completed", "reviewed_at", "review_scope"],
      "properties": {
        "completed": {"type": "boolean"},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "review_scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "report_summary": {
      "type": "object",
      "required": ["analysis_objective", "dataset_scope", "executive_summary", "key_messages", "coverage_summary", "limitations"],
      "properties": {
        "analysis_objective": {"type": "string", "minLength": 1},
        "dataset_scope": {"type": "string", "minLength": 1},
        "executive_summary": {"type": "string", "minLength": 1},
        "key_messages": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "coverage_summary": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "operator_id", "scope", "sample_count", "artifact_paths", "warnings"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "operator_id": {"type": "string", "pattern": "^A[0-9]{3}$"},
          "scope": {"type": "object"},
          "sample_count": {"type": "integer", "minimum": 0},
          "artifact_paths": {"type": "array", "items": {"type": "string"}},
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "evidence_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation_id", "evidence_ids", "relation_type", "independence", "rationale", "status"],
        "properties": {
          "relation_id": {"type": "string", "pattern": "^R[0-9]{5}$"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
          "relation_type": {"enum": ["corroborates", "duplicates", "refines", "localizes", "conditionalizes", "contradicts", "apparent_contradiction", "exception", "incomparable", "comparison_candidate", "unresolved"]},
          "candidate_relation": {"enum": ["global_local_contrast", "parameter_contrast", "cross_evidence_comparison"]},
          "independence": {"enum": ["high", "medium", "low", "unknown"]},
          "rationale": {"type": "string", "minLength": 1},
          "status": {"enum": ["candidate", "reviewed", "validated"]}
        },
        "additionalProperties": true
      }
    },
    "unresolved_contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary", "evidence_ids"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "additionalProperties": true
      }
    },
    "contradiction_assessment": {
      "type": "object",
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["not_assessed", "none_found", "found"]},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "exploration_summary": {
      "type": "object",
      "required": ["stage", "attempted_analysis_signatures", "negative_results_preserved", "falsification_required"],
      "properties": {
        "stage": {"enum": ["discovery", "validation", "mixed"]},
        "attempted_analysis_signatures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "negative_results_preserved": {"type": "boolean"},
        "falsification_required": {"const": true}
      },
      "additionalProperties": true
    },
    "notable_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "title",
          "scientific_question",
          "analysis_context",
          "observation",
          "interpretation",
          "why_notable",
          "evidence_ids",
          "result_values",
          "warnings",
          "limitations",
          "status"
        ],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^F[0-9]{4}$"},
          "title": {"type": "string", "minLength": 1},
          "scientific_question": {"type": "string", "minLength": 1},
          "analysis_context": {
            "type": "object",
            "required": ["operator_id", "operator_name", "scope_mode", "sample_count"],
            "properties": {
              "operator_id": {"type": "string", "pattern": "^A[0-9]{3}$"},
              "operator_name": {"type": "string", "minLength": 1},
              "evaluation_representation": {"type": ["string", "null"]},
              "evaluation_family": {"type": ["string", "null"]},
              "grouping_representation": {"type": ["string", "null"]},
              "grouping_family": {"type": ["string", "null"]},
              "scope_mode": {"type": "string", "minLength": 1},
              "target_group_id": {"type": ["string", "null"]},
              "comparison_group_id": {"type": ["string", "null"]},
              "sample_count": {"type": "integer", "minimum": 0},
              "sample_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "metric": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          },
          "observation": {"type": "string", "minLength": 1},
          "interpretation": {"type": "string", "minLength": 1},
          "why_notable": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "result_values": {"type": "object"},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["discovery", "validated", "refuted", "inconclusive", "negative"]}
        },
        "additionalProperties": true
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hypothesis_id",
          "title",
          "scientific_question",
          "claim",
          "target_group",
          "observation",
          "interpretation",
          "why_notable",
          "supporting_evidence",
          "contradicting_evidence",
          "evidence_independence",
          "alternative_explanations",
          "limitations",
          "scope",
          "exceptions",
          "confidence",
          "confidence_rationale",
          "proposed_structural_implication",
          "recommended_next_analysis",
          "recommended_next_compounds",
          "human_review_points",
          "falsification_status"
        ],
        "properties": {
          "hypothesis_id": {"type": "string", "pattern": "^H[0-9]{4}$"},
          "title": {"type": "string", "minLength": 1},
          "scientific_question": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "target_group": {"type": ["string", "null"]},
          "observation": {"type": "string", "minLength": 1},
          "interpretation": {"type": "string", "minLength": 1},
          "why_notable": {"type": "string", "minLength": 1},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "contradicting_evidence": {"type": "array", "items": {"type": "string"}},
          "evidence_independence": {"type": "string", "minLength": 1},
          "alternative_explanations": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "scope": {"type": "array", "items": {"type": "string"}},
          "exceptions": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["exploratory", "low", "low_to_medium", "medium", "medium_to_high", "high"]},
          "confidence_rationale": {"type": "string", "minLength": 1},
          "proposed_structural_implication": {"type": "string"},
          "recommended_next_analysis": {"type": "array", "items": {"type": "string"}},
          "recommended_next_compounds": {"type": "array", "items": {"type": "string"}},
          "human_review_points": {"type": "array", "items": {"type": "string"}},
          "falsification_status": {"enum": ["required", "planned", "tested_supported", "tested_refuted", "unavailable"]}
        },
        "additionalProperties": true
      }
    },
    "recommended_next_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "action", "purpose", "approval_status"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[FH][0-9]{4}$"},
          "action": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["characterize", "falsify", "control", "replicate"]},
          "approval_status": {"const": "orchestrator_must_determine"}
        },
        "additionalProperties": true
      }
    },
    "human_review_points": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
