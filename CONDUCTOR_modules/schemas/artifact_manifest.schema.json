{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/artifact_manifest.schema.json",
  "title": "CONDUCTOR 0.2.1 Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "status", "config_sha256", "input_artifacts", "artifacts", "metrics", "warnings", "created_at"],
  "properties": {
    "schema_version": {"const": "0.2.1"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "node_id", "attempt_id", "skill_name"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "node_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "skill_name": {"type": "string", "pattern": "^cs-[a-z0-9-]+$"}
      }
    },
    "status": {"enum": ["succeeded", "failed", "needs_design_review"]},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "role", "path", "media_type", "schema", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^ART\\|[a-f0-9]{16}$"},
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"},
          "media_type": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1},
          "rows": {"type": ["integer", "null"], "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "metrics": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
