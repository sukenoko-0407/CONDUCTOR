{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/artifact_manifest.schema.json",
  "title": "CONDUCTOR artifact manifest",
  "type": "object",
  "required": ["schema_version", "conductor_version", "artifact_stage", "run_id", "capability_id", "skill_name", "skill_version", "input", "input_hash", "value_semantics", "natural_metric", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "conductor_version": {"const": "0.1.8"},
    "artifact_stage": {"enum": ["description", "clustering", "analysis"]},
    "run_id": {"type": "string", "minLength": 1},
    "node_id": {"type": ["string", "null"]},
    "attempt_id": {"type": ["string", "null"]},
    "capability_id": {"type": "string", "pattern": "^[DCA][0-9]{3}$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"},
    "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "input": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "value_semantics": {"type": "string", "minLength": 1},
    "natural_metric": {"type": ["string", "null"]},
    "feature_columns": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
