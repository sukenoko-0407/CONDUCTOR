{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/review_bundle.schema.json",
  "title": "CONDUCTOR Review Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "bundle_type", "round_id", "capability_id", "interpretation_profile_id", "comparison_family_id", "target_result_refs", "comparator_result_refs", "all_result_refs", "cluster_ids", "comparison_status", "applicable_axes", "comparison_table", "runtime_facts", "source_hash", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "pattern": "^RVB[0-9a-f]{16}$"},
    "bundle_type": {"enum": ["global", "global_local", "sibling_cluster", "cross_evidence"]},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "capability_id": {"type": "string", "pattern": "^A[0-9]{3}$"},
    "interpretation_profile_id": {"type": "string"},
    "comparison_family_id": {"type": "string", "pattern": "^CFM[0-9a-f]{16}$"},
    "target_result_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "comparator_result_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "all_result_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "cluster_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{6}$"}, "uniqueItems": true},
    "comparison_status": {"enum": ["ready", "awaiting_comparator", "not_applicable"]},
    "applicable_axes": {"type": "array", "items": {"enum": ["favorable_signal", "context_deviation", "chemical_actionability", "independent_support", "follow_up_leverage"]}, "uniqueItems": true},
    "comparison_table": {"type": "array", "items": {"type": "object"}},
    "evaluation_anchors": {
      "type": "object",
      "additionalProperties": {
        "type": "array", "minItems": 4, "maxItems": 4,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "runtime_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_support", "comparator_validity", "overlap_status", "minimum_support_met"],
      "properties": {
        "sample_support": {"enum": ["insufficient", "limited", "moderate", "strong"]},
        "comparator_validity": {"enum": ["none", "partial", "matched"]},
        "overlap_status": {"enum": ["not_applicable", "unknown", "overlapping", "independent"]},
        "minimum_support_met": {"type": "boolean"}
      }
    },
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
