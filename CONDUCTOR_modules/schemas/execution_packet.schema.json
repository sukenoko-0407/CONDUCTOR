{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/execution_packet.schema.json",
  "title": "CONDUCTOR 0.2.0 Execution Request packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "packet_id", "run_id", "round_id",
    "control_revision", "required_action", "lease_token_hash",
    "node_ids", "capability_ids", "execution_contracts",
    "timeout_minutes", "clean_scratch", "created_at", "expires_at", "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_version": {"const": "0.2.0"},
    "packet_id": {"type": "string", "pattern": "^PKT[0-9TZ_]+[0-9a-f]{8}$"},
    "run_id": {"type": "string", "minLength": 1},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "control_revision": {"type": "integer", "minimum": 1},
    "required_action": {"const": "EXECUTE_RUNNABLE_BATCH"},
    "lease_token_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^N[0-9]{6}$"}},
    "capability_ids": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "string", "minLength": 2}},
    "execution_contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "capability_id", "attempt_id", "node_signature", "input_nodes", "request_path", "request_hash", "command_argv", "command_hash", "working_directory", "scratch", "skill_output", "environment", "expected_output_ref", "validation"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
          "capability_id": {"type": "string", "minLength": 2},
          "attempt_id": {"type": "string", "pattern": "^ATT[0-9]{4}$"},
          "node_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "input_nodes": {"type": "array", "items": {"type": "string", "pattern": "^N[0-9]{6}$"}},
          "request_path": {"type": "string", "minLength": 1},
          "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "command_argv": {
            "type": "array",
            "minItems": 2,
            "prefixItems": [{"const": "<CONDUCTOR_RUNTIME_PYTHON>"}],
            "items": {"type": "string"}
          },
          "command_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "working_directory": {"type": "string", "minLength": 1},
          "scratch": {"type": "string", "minLength": 1},
          "skill_output": {"type": "string", "minLength": 1},
          "environment": {"type": "object", "additionalProperties": {"type": "string"}},
          "expected_output_ref": {"type": "string", "minLength": 1},
          "validation": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
    "clean_scratch": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
