{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/screening_summary.schema.json",
  "title": "CONDUCTOR Round Review Summary v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "round_id", "report_mode", "bundle_count", "evaluated_count", "not_scorable_count", "awaiting_comparator_count", "unassessed_count", "candidate_class_counts", "operator_counts", "bundle_type_counts", "reportable_candidates", "assessment_index_ref", "assessment_csv_ref", "bundle_index_ref", "stop_reason", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "run_id": {"type": "string"},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "report_mode": {"enum": ["screening", "full"]},
    "screening_scope": {"enum": ["current_round", "historical_closed_rounds"]},
    "source_round_ids": {"type": "array", "items": {"type": "string", "pattern": "^RND[0-9]{4}$"}, "uniqueItems": true},
    "bundle_count": {"type": "integer", "minimum": 0},
    "evaluated_count": {"type": "integer", "minimum": 0},
    "not_scorable_count": {"type": "integer", "minimum": 0},
    "awaiting_comparator_count": {"type": "integer", "minimum": 0},
    "unassessed_count": {"type": "integer", "minimum": 0},
    "candidate_class_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "operator_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "bundle_type_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "reportable_candidates": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
    "assessment_index_ref": {"type": "string"},
    "assessment_csv_ref": {"type": "string"},
    "bundle_index_ref": {"type": "string"},
    "stop_reason": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
