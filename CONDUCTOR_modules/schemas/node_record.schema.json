{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CONDUCTOR 0.1.10 DAG Node",
  "type": "object",
  "required": [
    "node_id", "capability_id", "skill_name", "stage", "wave", "round_id",
    "dependencies", "parameters", "signature", "status", "attempts",
    "result", "error", "waived", "created_at", "updated_at"
  ],
  "properties": {
    "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "capability_id": {"type": "string", "pattern": "^[DCAI][0-9]{3}$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"},
    "stage": {"enum": ["description", "clustering", "analysis", "interpretation", "orchestration"]},
    "wave": {"enum": ["basic", "standard", "interpretation"]},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^N[0-9]{6}$"}},
    "parameters": {"type": "object"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["pending", "running", "succeeded", "failed", "cancelled"]},
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt_id", "status"],
        "properties": {
          "attempt_id": {"type": "string", "pattern": "^ATT[0-9]{4}$"},
          "status": {"enum": ["running", "succeeded", "failed", "cancelled"]},
          "runtime_pid": {"type": "integer", "minimum": 1},
          "runtime_host": {"type": "string", "minLength": 1},
          "request_path": {"type": "string", "minLength": 1},
          "log_path": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "message": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "result": {"type": ["object", "null"]},
    "error": {"type": ["object", "null"]},
    "waived": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {
        "properties": {
          "result": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "error": {"type": "object"},
          "attempts": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": true
}
