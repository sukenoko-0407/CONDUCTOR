{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/capability.schema.json",
  "title": "CONDUCTOR Skill capability",
  "type": "object",
  "required": ["schema_version", "capability_id", "skill_name", "display_name", "version", "stage", "family", "description", "cost", "applicability", "dependencies", "input_contract", "output", "implementation"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "capability_id": {"type": "string", "pattern": "^[DCAIO][0-9]{3}$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"},
    "display_name": {"type": "string", "minLength": 1},
    "version": {"const": "0.1.0"},
    "stage": {"enum": ["description", "clustering", "analysis", "interpretation", "orchestration"]},
    "family": {"type": "string", "minLength": 1},
    "clustering_kind": {"enum": ["direct_structure", "description_vector", "categorical", "meta"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 2048},
    "cost": {
      "type": "object",
      "required": ["class", "human_approval_required", "hpc_profile"],
      "properties": {
        "class": {"enum": ["low", "medium", "high", "very_high"]},
        "human_approval_required": {"type": "boolean"},
        "hpc_profile": {"enum": ["cpu64", "a100_cpu8"]}
      },
      "additionalProperties": true
    },
    "applicability": {"type": "object", "required": ["status", "platforms"], "properties": {"status": {"enum": ["stable", "experimental", "planned"]}, "platforms": {"type": "array", "items": {"enum": ["linux-64", "win-64"]}, "minItems": 1, "uniqueItems": true}}, "additionalProperties": true},
    "approval_policy": {"enum": ["standard", "preauthorized_initial"]},
    "default_variant": {"type": "string", "minLength": 1},
    "default_parameters": {"type": "object"},
    "scope_support": {"type": "array", "items": {"enum": ["global", "within-cluster", "between-clusters", "projection-fit", "cluster-overlay", "global-model", "cluster-survey"]}, "minItems": 1, "uniqueItems": true},
    "value_semantics": {"type": "string"},
    "natural_metric": {"type": ["string", "null"]},
    "allowed_metrics": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"enum": ["description", "clustering", "analysis"]}},
    "input_contract": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "output": {"type": "object", "minProperties": 1},
    "implementation": {"type": "object", "minProperties": 1}
  },
  "additionalProperties": true
}
