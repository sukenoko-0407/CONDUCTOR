{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/finding.schema.json",
  "title": "CONDUCTOR 0.2.1 Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "finding_key", "lens", "endpoint_ids", "claim", "tests", "falsification", "triviality", "translation", "entities", "citations", "scores", "state", "labels", "merged_into", "narrative"],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^F[0-9]{6}$"},
    "finding_key": {"type": "string", "pattern": "^FND\\|[a-f0-9]{16}$"},
    "lens": {"enum": ["L1b", "L2a", "L2b", "L4", "L5", "L7"]},
    "endpoint_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim": {"$ref": "#/$defs/claim"},
    "tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test"}},
    "falsification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parameters", "decision_rule"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "decision_rule": {"type": "string", "minLength": 1}
      }
    },
    "triviality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confounders_tested", "raw_effect_size", "adjusted_effect_size", "verdict"],
      "properties": {
        "confounders_tested": {"type": "array", "items": {"type": "string"}},
        "raw_effect_size": {"type": "number"},
        "adjusted_effect_size": {"type": "number"},
        "verdict": {"enum": ["notable", "mostly_trivial", "not_assessed"]}
      }
    },
    "translation": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["native", "translated", "untranslatable", "not_required"]}},
      "additionalProperties": true
    },
    "entities": {"$ref": "#/$defs/entities"},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "scores": {"$ref": "#/$defs/scores"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline", "deep_dive"],
      "properties": {
        "pipeline": {"enum": ["candidate", "reportable", "merged", "refuted", "not_testable"]},
        "deep_dive": {"enum": ["not_dived", "SURVIVED", "WEAKENED", "REFUTED", "INCONCLUSIVE"]}
      }
    },
    "labels": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "merged_into": {"type": ["string", "null"], "pattern": "^F[0-9]{6}$"},
    "narrative": {"type": ["string", "null"]}
  },
  "$defs": {
    "nullable_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "condition_id", "condition_depth", "effect_direction", "effect_size", "effect_unit", "support_n"],
      "properties": {
        "subject_type": {"enum": ["context", "fragment", "transformation", "feature", "region", "series_pair"]},
        "subject_id": {"type": "string", "minLength": 1},
        "condition_id": {"type": ["string", "null"]},
        "condition_depth": {"type": "integer", "minimum": 0, "maximum": 1},
        "effect_direction": {"enum": ["positive", "negative", "mixed", "flat"]},
        "effect_size": {"type": "number"},
        "effect_unit": {"type": "string", "minLength": 1},
        "support_n": {"type": "integer", "minimum": 1}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "question", "method", "statistic", "p_value", "q_value", "null_iterations"],
      "properties": {
        "test_id": {"type": "string", "pattern": "^TEST\\|[a-f0-9]{16}$"},
        "question": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "statistic": {"type": "number"},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "q_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "null_iterations": {"type": "integer", "minimum": 0}
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_ids", "scaffold_ids", "transformation_ids", "fragment_ids", "compound_ids", "feature_ids"],
      "properties": {
        "context_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "scaffold_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "transformation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "fragment_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "compound_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "feature_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "table_ref"],
      "properties": {
        "citation_id": {"type": "string", "minLength": 1},
        "table_ref": {"type": "string", "pattern": "^[^#]+#row_id=.+$"}
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statistical_strength", "robustness", "non_triviality", "actionability", "frontier_relevance", "composite", "rank"],
      "properties": {
        "statistical_strength": {"$ref": "#/$defs/nullable_score"},
        "robustness": {"$ref": "#/$defs/nullable_score"},
        "non_triviality": {"$ref": "#/$defs/nullable_score"},
        "actionability": {"$ref": "#/$defs/nullable_score"},
        "frontier_relevance": {"$ref": "#/$defs/nullable_score"},
        "composite": {"$ref": "#/$defs/nullable_score"},
        "rank": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
