{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/recovery_manifest.schema.json",
  "title": "CONDUCTOR 0.1.3 adaptive recovery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "attempt_id", "node_signature", "failure_classification", "reason", "changed_contract_fields", "scientific_invariants_unchanged", "command_hash", "temporary_file_hashes", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "attempt_id": {"type": "string", "pattern": "^ATT[0-9]{4}$"},
    "node_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "failure_classification": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "changed_contract_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["option_alias", "optional_default", "path", "working_directory", "input_column_alias", "format_adapter", "environment_initialization"]}
    },
    "scientific_invariants_unchanged": {"const": true},
    "command_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "temporary_file_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
