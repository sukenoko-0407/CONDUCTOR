{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CONDUCTOR 0.1.10 execution event",
  "type": "object",
  "required": ["schema_version", "project", "run_id", "round_id", "node_id", "attempt_id", "capability_id", "skill_name", "status", "artifacts"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0", "2.0.0"]},
    "conductor_version": {"type": "string"},
    "project": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "attempt_id": {"type": "string", "pattern": "^ATT[0-9]{4}$"},
    "capability_id": {"type": "string", "pattern": "^[DCAI][0-9]{3}$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"},
    "status": {"enum": ["succeeded", "failed", "skipped", "not_applicable", "unavailable"]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
