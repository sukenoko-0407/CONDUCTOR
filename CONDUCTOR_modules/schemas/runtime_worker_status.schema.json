{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/runtime_worker_status.schema.json",
  "title": "CONDUCTOR Runtime Worker status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "packet_id", "run_id", "round_id",
    "status", "node_ids", "worker_pid", "worker_host", "execution_timeout_seconds",
    "clean_scratch", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_version": {"const": "0.1.8"},
    "packet_id": {"type": "string", "pattern": "^PKT[0-9TZ_]+[0-9a-f]{8}$"},
    "run_id": {"type": "string", "minLength": 1},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "status": {"enum": ["claiming", "claimed", "launching", "running", "terminal", "worker_start_failed"]},
    "node_ids": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^N[0-9]{6}$"}
    },
    "worker_pid": {"type": ["integer", "null"], "minimum": 1},
    "worker_host": {"type": ["string", "null"]},
    "launcher_pid": {"type": ["integer", "null"], "minimum": 1},
    "execution_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "clean_scratch": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "succeeded_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "affected_node_ids": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^N[0-9]{6}$"}
    },
    "returncode": {"type": "integer"},
    "error": {"type": ["string", "null"], "maxLength": 2000}
  }
}
