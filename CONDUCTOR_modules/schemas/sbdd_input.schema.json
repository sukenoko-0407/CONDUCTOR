{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/sbdd_input.schema.json",
  "title": "CONDUCTOR reserved SBDD input manifest",
  "description": "Extension contract only; CONDUCTOR 0.1.2 does not execute SBDD calculations.",
  "type": "object",
  "required": ["schema_version", "prepared_by_human"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "prepared_by_human": {"const": true},
    "receptor": {
      "type": "object",
      "required": ["path", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["pdb", "mmcif"]}
      },
      "additionalProperties": true
    },
    "ligand_poses": {
      "type": "object",
      "required": ["path", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"const": "sdf"},
        "compound_id_property": {"type": "string"}
      },
      "additionalProperties": true
    },
    "interaction_features": {
      "type": "object",
      "required": ["path", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["prolif_json", "ifp_csv", "ifp_parquet"]},
        "compound_id_column": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "anyOf": [
    {"required": ["receptor", "ligand_poses"]},
    {"required": ["interaction_features"]}
  ],
  "additionalProperties": true
}
