{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/analysis_result.schema.json",
  "title": "Canonical Analysis Result",
  "type": "object",
  "required": ["document_type", "schema_version", "node_id", "capability_id", "analysis_subject", "primary_payload", "report", "result_cards", "created_at"],
  "properties": {
    "document_type": {"const": "analysis_result"},
    "schema_version": {"const": "1.0.0"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "capability_id": {"type": "string", "pattern": "^A[0-9]{3}$"},
    "analysis_subject": {"$ref": "analysis_subject.schema.json"},
    "primary_payload": {"type": "string", "pattern": "^[^/\\\\]+$"},
    "report": {"type": "string", "pattern": "^[^/\\\\]+$"},
    "result_cards": {"type": "array", "items": {"type": "string", "pattern": "^[^/\\\\]+$"}},
    "payloads": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
