{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/working_set.schema.json",
  "title": "CONDUCTOR Bounded Working Set",
  "type": "object",
  "required": ["schema_version", "run_id", "round_id", "control_revision", "required_action", "round_contract", "human_priorities", "unmet_deliverables", "insights", "results", "candidates", "query_pointers", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "round_id": {"type": ["string", "null"]},
    "control_revision": {"type": "integer"},
    "required_action": {"type": "object"},
    "round_contract": {"type": ["object", "null"]},
    "human_priorities": {"type": "array"},
    "unmet_deliverables": {"type": "array"},
    "insights": {"type": "array", "maxItems": 20},
    "results": {"type": "array", "maxItems": 20},
    "candidates": {"type": "array", "maxItems": 20},
    "query_pointers": {"type": "array"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
