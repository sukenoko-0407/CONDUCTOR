{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/analysis_profile.schema.json",
  "title": "CONDUCTOR analysis profile",
  "type": "object",
  "required": ["schema_version", "profile_id", "managed_by", "basic_compute", "initial_exploration", "additional_exploration", "runtime_planning", "modeling"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "managed_by": {"const": "human"},
    "basic_compute": {"type": "object", "required": ["description_capabilities", "direct_structure_clustering", "vector_clustering_capabilities", "vector_clustering_representations", "high_cost_bundle"]},
    "initial_exploration": {"type": "object", "required": ["description_master_panel", "global_operator_capabilities", "local_operator_capabilities", "projection_overlay_capabilities", "representative_clusters_per_clustering"]},
    "additional_exploration": {"type": "object", "required": ["operator_capabilities", "stratify_by", "sampling"]},
    "runtime_planning": {"type": "object", "required": ["max_new_analysis_nodes_per_round", "analysis_materialization_batch_size", "initial_global_analysis_node_limit"], "properties": {"max_new_analysis_nodes_per_round": {"const": 200}, "analysis_materialization_batch_size": {"const": 50}, "initial_global_analysis_node_limit": {"const": 100}}, "additionalProperties": false},
    "modeling": {"type": "object", "required": ["fixed_description_panel", "minimum_local_samples"]},
    "matched_molecular_pairs": {
      "type": "object",
      "required": ["capability_id", "global_role", "screen_role", "detail_role", "representative_clustering_capabilities", "representative_clusters_per_clustering", "max_reference_cards_in_working_set"],
      "properties": {
        "capability_id": {"const": "A014"},
        "global_role": {"const": "global-build"},
        "screen_role": {"const": "local-screen"},
        "detail_role": {"const": "local-detail"},
        "representative_clustering_capabilities": {"type": "array", "items": {"pattern": "^C[0-9]{3}$"}, "minItems": 4, "maxItems": 6, "uniqueItems": true},
        "representative_clusters_per_clustering": {"const": 1},
        "max_reference_cards_in_working_set": {"type": "integer", "minimum": 1, "maximum": 50}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
