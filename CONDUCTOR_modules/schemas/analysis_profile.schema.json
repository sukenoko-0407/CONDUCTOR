{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/analysis_profile.schema.json",
  "title": "CONDUCTOR 0.1.6 analysis profile",
  "type": "object",
  "required": ["schema_version", "profile_id", "managed_by", "basic_compute", "exploration", "runtime_planning", "modeling"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "managed_by": {"const": "human"},
    "description": {"type": "string"},
    "basic_compute": {"type": "object", "required": ["description_capabilities", "direct_structure_clustering", "vector_clustering_capabilities", "vector_clustering_representations", "high_cost_bundle"], "additionalProperties": true},
    "exploration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description_panel", "global_operator_capabilities", "local_operator_capabilities", "scope_sequence", "representative_clusters_per_clustering", "sampling", "random_seed"],
      "properties": {
        "description_panel": {"type": "array", "items": {"pattern": "^D[0-9]{3}$"}, "uniqueItems": true},
        "global_operator_capabilities": {"type": "array", "items": {"pattern": "^A[0-9]{3}$"}, "uniqueItems": true},
        "local_operator_capabilities": {"type": "array", "items": {"pattern": "^A[0-9]{3}$"}, "uniqueItems": true},
        "scope_sequence": {"const": ["global", "global", "local"]},
        "representative_clusters_per_clustering": {"type": "integer", "minimum": 1, "maximum": 10},
        "sampling": {"const": "seeded_history_balanced_without_replacement"},
        "random_seed": {"type": "integer"}
      }
    },
    "runtime_planning": {"type": "object", "required": ["max_new_analysis_nodes_per_round", "max_interpretation_result_cards"], "properties": {"max_new_analysis_nodes_per_round": {"const": 50}, "max_interpretation_result_cards": {"const": 50}}, "additionalProperties": false},
    "modeling": {"type": "object", "required": ["fixed_description_panel", "minimum_local_samples"]},
    "matched_molecular_pairs": {
      "type": "object",
      "required": ["capability_id", "global_role", "standard_flow", "manual_interpretation_skill", "standard_result_reference_examples"],
      "properties": {
        "capability_id": {"const": "A014"},
        "global_role": {"const": "global-build"},
        "standard_flow": {"const": "global_only"},
        "manual_interpretation_skill": {"const": "cs-analysis-interpret-mmp"},
        "standard_result_reference_examples": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
