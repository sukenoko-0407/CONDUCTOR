{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/screening_batch.schema.json",
  "title": "CONDUCTOR Review Bundle Screening Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "run_id", "round_id", "batch_id", "rubric_version", "allowed_result_refs", "target_bundle_ids", "review_bundles", "result_cards", "interpretation_profiles", "rubric", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "mode": {"const": "screening"},
    "run_id": {"type": "string"},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "batch_id": {"type": "string", "pattern": "^SCR[0-9a-f]{16}$"},
    "rubric_version": {"const": "2.0.0"},
    "allowed_result_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "target_bundle_ids": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "pattern": "^RVB[0-9a-f]{16}$"}, "uniqueItems": true},
    "review_bundles": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "review_bundle.schema.json"}},
    "result_cards": {"type": "array", "minItems": 1, "items": {"$ref": "result_card.schema.json"}},
    "interpretation_profiles": {"type": "array", "minItems": 1, "items": {"$ref": "operator_interpretation_profile.schema.json"}},
    "rubric": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
