{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/screening_draft.schema.json",
  "title": "CONDUCTOR Review Bundle Screening Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "assessments"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "batch_id": {"type": "string", "pattern": "^SCR[0-9a-f]{16}$"},
    "assessments": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["bundle_id", "assessment_status", "scores", "effect_stability", "independence", "reason", "supporting_result_refs", "counter_result_refs"],
        "properties": {
          "bundle_id": {"type": "string", "pattern": "^RVB[0-9a-f]{16}$"},
          "assessment_status": {"enum": ["evaluated", "not_scorable"]},
          "scores": {"type": ["object", "null"], "additionalProperties": false, "required": ["favorable_evidence", "context_contrast", "evidence_specificity"], "properties": {
            "favorable_evidence": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 3}, {"const": "not_applicable"}]},
            "context_contrast": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 3}, {"const": "not_applicable"}]},
            "evidence_specificity": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 3}, {"const": "not_applicable"}]}
          }},
          "effect_stability": {"type": ["string", "null"], "enum": ["unknown", "unstable", "mixed", "stable", null]},
          "independence": {"type": ["string", "null"], "enum": ["unknown", "overlapping", "partially_independent", "independent", null]},
          "reason": {"type": "string", "minLength": 12, "maxLength": 1200},
          "supporting_result_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "counter_result_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
