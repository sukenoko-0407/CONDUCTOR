{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/operator_interpretation_profile.schema.json",
  "title": "Operator Interpretation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "result_role", "allowed_axes", "comparison_metrics", "primary_favorable_metric", "global_comparator", "sibling_comparison", "standalone_insight", "minimum_support", "null_result", "anchors"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "profile_id": {"type": "string", "pattern": "^IP-A[0-9]{3}-2\\.0\\.0$"},
    "result_role": {"enum": ["activity_signal", "landscape", "model", "context", "quality", "specialized"]},
    "allowed_axes": {"type": "array", "items": {"enum": ["favorable_evidence", "context_contrast", "evidence_specificity"]}, "uniqueItems": true},
    "comparison_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "unit", "direction", "comparison_scope"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "unit": {"type": ["string", "null"]},
          "direction": {"enum": ["favorable", "higher", "lower", "absolute", "neutral"]},
          "comparison_scope": {"enum": ["global", "global_local", "sibling", "all"]}
        }
      }
    },
    "primary_favorable_metric": {"type": ["string", "null"]},
    "global_comparator": {"enum": ["required_for_local", "optional", "not_applicable"]},
    "sibling_comparison": {"enum": ["required", "supported", "not_applicable"]},
    "standalone_insight": {"enum": ["allowed", "conditional", "supporting_only", "specialized_only"]},
    "minimum_support": {"type": "object", "additionalProperties": false, "required": ["global", "local"], "properties": {"global": {"type": "integer", "minimum": 2}, "local": {"type": "integer", "minimum": 5}}},
    "null_result": {"enum": ["background", "supporting", "not_scorable"]},
    "anchors": {"type": "object", "additionalProperties": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}}}
  }
}
