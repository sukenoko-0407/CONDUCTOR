{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/result_assessment.schema.json",
  "title": "CONDUCTOR Review Bundle Assessment v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "bundle_id", "bundle_type", "round_id", "capability_id", "target_result_refs", "assessment_status", "candidate_class", "scores", "reliability", "reason", "supporting_result_refs", "counter_result_refs", "rubric_version", "source_hash", "revision", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "assessment_id": {"type": "string", "pattern": "^ASR[0-9a-f]{16}$"},
    "bundle_id": {"type": "string", "pattern": "^RVB[0-9a-f]{16}$"},
    "bundle_type": {"enum": ["global", "global_local", "sibling_cluster", "cross_evidence"]},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "capability_id": {"type": "string", "pattern": "^A[0-9]{3}$"},
    "target_result_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "assessment_status": {"enum": ["evaluated", "not_scorable", "awaiting_comparator"]},
    "candidate_class": {"enum": ["design_lead", "contextual_anomaly", "supporting_evidence", "background", "not_scorable", "awaiting_comparator"]},
    "scores": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["favorable_signal", "context_deviation", "chemical_actionability", "independent_support", "follow_up_leverage"],
      "properties": {
        "favorable_signal": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 3}, {"const": "not_applicable"}]},
        "context_deviation": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 3}, {"const": "not_applicable"}]},
        "chemical_actionability": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 3}, {"const": "not_applicable"}]},
        "independent_support": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 3}, {"const": "not_applicable"}]},
        "follow_up_leverage": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 3}, {"const": "not_applicable"}]}
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_support", "comparator_validity", "effect_stability", "independence", "quality_flags"],
      "properties": {
        "sample_support": {"enum": ["insufficient", "limited", "moderate", "strong"]},
        "comparator_validity": {"enum": ["none", "partial", "matched"]},
        "effect_stability": {"enum": ["unknown", "unstable", "mixed", "stable"]},
        "independence": {"enum": ["unknown", "overlapping", "partially_independent", "independent"]},
        "quality_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 1200},
    "supporting_result_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "counter_result_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rubric_version": {"const": "2.0.0"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
