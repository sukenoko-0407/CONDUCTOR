{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/interpretation_review_manifest.schema.json",
  "title": "Interpretation Review Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "round_id", "selected_bundle_ids", "detailed_result_refs", "unselected_bundles", "candidate_class_counts", "bundle_type_counts", "operator_counts", "selection_method", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "selected_bundle_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "detailed_result_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unselected_bundles": {"type": "array", "items": {"type": "object"}},
    "candidate_class_counts": {"type": "object"},
    "bundle_type_counts": {"type": "object"},
    "operator_counts": {"type": "object"},
    "selection_method": {"const": "candidate_priority_v3"},
    "synthesis_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle_id", "disposition", "reason"],
        "properties": {
          "bundle_id": {"type": "string", "pattern": "^RVB[0-9a-f]{16}$"},
          "disposition": {
            "enum": [
              "reported_as_insight", "merged_into_insight",
              "rejected_by_counterevidence", "redundant_evidence",
              "deferred_by_detail_limit", "not_reportable"
            ]
          },
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "interpretation_scope": {"enum": ["current_round", "cumulative_unreported"]},
    "source_round_ids": {"type": "array", "items": {"type": "string", "pattern": "^RND[0-9]{4}$"}, "uniqueItems": true},
    "source_assessment_count": {"type": "integer", "minimum": 0},
    "previously_reported_count": {"type": "integer", "minimum": 0},
    "unavailable_or_stale_count": {"type": "integer", "minimum": 0},
    "excluded_previously_reported_bundle_ids": {"type": "array", "items": {"type": "string", "pattern": "^RVB[0-9a-f]{16}$"}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
