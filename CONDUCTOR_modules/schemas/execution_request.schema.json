{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/execution_request.schema.json",
  "title": "CONDUCTOR 0.2.1 Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "endpoint_id", "config_path", "random_seed", "inputs", "parameters", "resources"],
  "properties": {
    "schema_version": {"const": "0.2.1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "run_id", "phase_id", "node_id", "attempt_id", "skill_name"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "phase_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
        "node_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "skill_name": {"type": "string", "pattern": "^cs-[a-z0-9-]+$"}
      }
    },
    "endpoint_id": {"type": "string", "minLength": 1},
    "config_path": {"type": "string", "minLength": 1},
    "random_seed": {"type": "integer", "minimum": 0},
    "inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/input_artifact"}
    },
    "parameters": {"type": "object"},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers", "memory_mb"],
      "properties": {
        "workers": {"type": "integer", "minimum": 0},
        "memory_mb": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "producer_manifest": {"type": ["string", "null"]}
      }
    }
  }
}
