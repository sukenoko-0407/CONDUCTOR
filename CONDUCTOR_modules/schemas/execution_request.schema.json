{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/execution_request.schema.json",
  "title": "CONDUCTOR Scientific Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "inputs", "columns", "endpoint", "subject", "parameters", "resources", "output", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "run_id", "round_id", "node_id", "attempt_id", "capability_id", "skill_name"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
        "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
        "attempt_id": {"type": "string", "pattern": "^ATT[0-9]{4}$"},
        "capability_id": {"type": "string", "pattern": "^[DCAI][0-9]{3}$"},
        "skill_name": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "artifact_type", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
          "source_capability_id": {"type": "string", "pattern": "^[DCAI][0-9]{3}$"},
          "result_path": {"type": "string", "minLength": 1},
          "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "dependentRequired": {
          "result_path": ["result_sha256"],
          "result_sha256": ["result_path"]
        }
      }
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compound_id": {"type": "string", "minLength": 1},
        "smiles": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["higher_is_better"],
      "properties": {"higher_is_better": {"type": "boolean"}}
    },
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "target_cluster_id": {"type": ["string", "null"]},
        "comparison_cluster_id": {"type": ["string", "null"]},
        "compound_set_hash": {"type": ["string", "null"]}
      }
    },
    "parameters": {"type": "object"},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_cpu_cores", "node_cpu_cores", "native_thread_limit", "skill_options"],
      "properties": {
        "available_cpu_cores": {"type": "integer", "minimum": 1},
        "node_cpu_cores": {"type": "integer", "minimum": 1},
        "native_thread_limit": {"type": "integer", "minimum": 1},
        "skill_options": {"type": "object"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "overwrite"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "overwrite": {"type": "boolean"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
