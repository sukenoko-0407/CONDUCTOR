{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CONDUCTOR 0.1.10 Skill Execution Request",
  "type": "object",
  "required": [
    "schema_version", "conductor_version", "identity", "inputs", "columns", "endpoint",
    "subject", "parameters", "resources", "output", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "conductor_version": {"const": "0.1.10"},
    "identity": {
      "type": "object",
      "required": [
        "project", "run_id", "round_id", "node_id", "attempt_id",
        "capability_id", "skill_name"
      ],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
        "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
        "attempt_id": {"type": "string", "pattern": "^ATT[0-9]{4}$"},
        "capability_id": {"type": "string", "pattern": "^[DCAI][0-9]{3}$"},
        "skill_name": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result_path": {"type": "string", "minLength": 1},
          "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "dependentRequired": {
          "result_path": ["result_sha256"],
          "result_sha256": ["result_path"]
        },
        "additionalProperties": true
      }
    },
    "columns": {
      "type": "object",
      "required": ["compound_id", "smiles", "endpoint"],
      "properties": {
        "compound_id": {"type": "string", "minLength": 1},
        "smiles": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "endpoint": {
      "type": "object",
      "required": ["higher_is_better"],
      "properties": {"higher_is_better": {"type": "boolean"}},
      "additionalProperties": true
    },
    "subject": {"type": "object"},
    "parameters": {"type": "object"},
    "resources": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "description_cache": {
      "type": "object",
      "required": [
        "program_name", "database_path", "calculation_version",
        "configuration_signature", "hit_count", "miss_count"
      ],
      "properties": {
        "program_name": {"type": "string", "minLength": 1},
        "database_path": {"type": "string", "minLength": 1},
        "calculation_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "configuration_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hit_count": {"type": "integer", "minimum": 0},
        "miss_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": ["directory"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "overwrite": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
