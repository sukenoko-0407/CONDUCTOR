{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/mmp_result.schema.json",
  "type": "object",
  "required": ["schema_version", "role", "scope", "negative_result", "endpoint", "higher_is_better", "counts", "core_policy", "artifacts", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "role": {"enum": ["global-build", "local-screen", "local-detail"]},
    "scope": {"enum": ["global", "cluster-survey", "within-cluster"]},
    "cluster_id": {"type": ["string", "null"]},
    "negative_result": {"type": "boolean"},
    "endpoint": {"type": "string"},
    "higher_is_better": {"type": "boolean"},
    "counts": {"type": "object"},
    "core_policy": {"type": "object", "required": ["min_heavy_atoms", "min_fraction_both_compounds", "max_variable_heavy_atoms"]},
    "artifacts": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
