{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/operator_summary.schema.json",
  "type": "object",
  "required": ["schema_version", "result_ref", "node_id", "attempt_id", "operator_id", "run_id", "round_id", "scope", "scope_context", "sample_count", "endpoint", "metric", "headline", "key_metrics", "limitations", "warnings", "source_nodes", "primary_artifact", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "result_ref": {"type": "string", "pattern": "^N[0-9]{6}@ATT[0-9]{4}(/C[0-9]{6})?$"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "attempt_id": {"type": "string", "pattern": "^ATT[0-9]{4}$"},
    "operator_id": {"const": "A014"},
    "run_id": {"type": "string"},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "scope": {"type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["global", "cluster-survey", "within-cluster"]}}, "additionalProperties": true},
    "scope_context": {"type": "object"},
    "sample_count": {"type": "integer", "minimum": 0},
    "endpoint": {"type": "object"},
    "metric": {"type": ["string", "null"]},
    "headline": {"type": "string", "minLength": 1},
    "key_metrics": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "source_nodes": {"type": "array", "items": {"type": "string"}},
    "primary_artifact": {"type": "object", "required": ["path", "sha256"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
