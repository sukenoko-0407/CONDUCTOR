{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/mmp_reference_card.schema.json",
  "type": "object",
  "required": ["schema_version", "card_id", "category", "scope", "headline", "support", "effect", "source_rows", "quality_flags"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "card_id": {"type": "string", "pattern": "^MRC-[A-F0-9]{12}$"},
    "category": {"enum": ["portable_transform", "core_dependent", "context_dependent", "cluster_dependent", "pair_cliff", "core_hotspot", "flat_transform", "contradiction", "coverage"]},
    "scope": {"type": "string"},
    "headline": {"type": "string"},
    "support": {"type": "object"},
    "effect": {"type": "object"},
    "source_rows": {"type": "array", "items": {"type": "string"}},
    "quality_flags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
