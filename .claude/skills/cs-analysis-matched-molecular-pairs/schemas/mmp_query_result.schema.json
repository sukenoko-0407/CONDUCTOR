{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/mmp_query_result.schema.json",
  "type": "object",
  "required": ["schema_version", "role", "query_spec_hash", "database_sha256", "negative_result", "rows", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "role": {"enum": ["local-screen", "local-detail"]},
    "query_spec_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "database_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "negative_result": {"type": "boolean"},
    "rows": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
