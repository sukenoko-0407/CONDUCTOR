{
  "schema_version": "2.0.0",
  "capability_id": "A014",
  "skill_name": "cs-analysis-matched-molecular-pairs",
  "display_name": "Matched molecular pair analysis",
  "version": "0.1.8",
  "stage": "analysis",
  "family": "matched_molecular_pairs",
  "description": "Build and query a reusable exhaustive matched molecular pair evidence database with exact-core and environment-aware Global-to-Cluster comparisons.",
  "cost": {
    "class": "high",
    "human_approval_required": false,
    "hpc_profile": "cpu64"
  },
  "approval_policy": "preauthorized_initial",
  "applicability": {
    "status": "stable",
    "platforms": [
      "linux-64",
      "win-64"
    ],
    "molecule_standardization": "out_of_scope"
  },
  "operator_id": "A014",
  "dependencies": [],
  "input_contract": [
    "endpoint_csv",
    "smiles",
    "optional_cluster_membership",
    "optional_global_mmp_database"
  ],
  "output": {
    "filename": "mmp_pair_detail.csv",
    "report": "operator_report.html",
    "summary": "operator_summary.json",
    "manifest": "analysis_manifest.json"
  },
  "implementation": {
    "operator": "matched_molecular_pairs",
    "engine": "mmpdb",
    "engine_version": "3.1.4"
  },
  "analysis_role": "matched_molecular_pairs",
  "roles": [
    "global-build",
    "local-screen",
    "local-detail"
  ],
  "scope_support": [
    "global",
    "cluster-survey",
    "within-cluster"
  ],
  "default_parameters": {
    "num_cuts": 2,
    "min_core_heavy_atoms": 8,
    "min_core_fraction": 0.5,
    "max_variable_heavy_atoms": 10,
    "min_radius": 0,
    "max_radius": 2,
    "extended_search": false,
    "max_compounds": 2000
  },
  "interpretation_profile": {
    "schema_version": "2.0.0", "profile_id": "IP-A014-2.0.0", "result_role": "specialized",
    "allowed_axes": ["favorable_evidence", "context_contrast", "evidence_specificity"],
    "comparison_metrics": [
      {"name": "pair_count", "source": "pair_count", "unit": "count", "direction": "higher", "comparison_scope": "global"},
      {"name": "transform_count", "source": "transform_count", "unit": "count", "direction": "higher", "comparison_scope": "global"}
    ],
    "primary_favorable_metric": null, "global_comparator": "not_applicable", "sibling_comparison": "not_applicable", "standalone_insight": "specialized_only",
    "minimum_support": {"global": 5, "local": 5}, "null_result": "not_scorable",
    "anchors": {
      "favorable_evidence": ["方向情報なし", "低支持のTransform", "限定contextで明確", "複数coreで一貫した方向"],
      "context_contrast": ["context差なし", "軽度の差", "GlobalとClusterで明確な差", "Transform効果の反転・局在"],
      "evidence_specificity": ["変換不明", "広い変換", "特定Transform/Core", "方向付きTransformと適用contextが明確"]
    }
  },
  "conductor_request": {
    "schema_version": "1.0.0",
    "adapter": "mmp_operator",
    "required_input_roles": [
      "dataset_or_mmp_database"
    ],
    "unknown_parameters": "reject_by_skill_cli"
  }
}
