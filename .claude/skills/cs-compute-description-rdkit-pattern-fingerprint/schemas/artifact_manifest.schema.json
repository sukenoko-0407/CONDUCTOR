{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/v4/artifact_manifest.schema.json",
  "title": "CONDUCTOR v4 Artifact Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "conductor_version",
    "run_id",
    "capability_id",
    "skill_name",
    "skill_version",
    "input",
    "input_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "conductor_version": {"const": "4.3.1"},
    "run_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "pattern": "^[DCAI][0-9]{3}$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"},
    "skill_version": {"type": "string", "minLength": 1},
    "input": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
