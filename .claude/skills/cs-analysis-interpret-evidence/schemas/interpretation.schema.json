{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/interpretation.schema.json",
  "title": "CONDUCTOR multi-Round interpretation",
  "type": "object",
  "required": ["schema_version", "policy_version", "run_id", "interpretation_id", "revision", "report_status", "agent_review", "report_summary", "evidence_index", "evidence_relations", "unresolved_contradictions", "contradiction_assessment", "exploration_summary", "notable_findings", "hypotheses", "questions", "analysis_requests", "recommended_next_analysis", "human_review_points", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "policy_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "round_id": {"type": ["string", "null"], "pattern": "^RND[0-9]{4,}$"},
    "interpretation_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "report_status": {"enum": ["draft", "agent_interpreted"]},
    "agent_review": {"type": "object", "required": ["completed", "reviewed_at", "review_scope"], "properties": {"completed": {"type": "boolean"}, "reviewed_at": {"type": ["string", "null"], "format": "date-time"}, "review_scope": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "report_summary": {"type": "object", "required": ["analysis_objective", "dataset_scope", "executive_summary", "key_messages", "coverage_summary", "limitations"], "properties": {"analysis_objective": {"type": "string", "minLength": 1}, "dataset_scope": {"type": "string", "minLength": 1}, "executive_summary": {"type": "string", "minLength": 1}, "key_messages": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "coverage_summary": {"type": "string", "minLength": 1}, "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": true},
    "evidence_index": {"type": "array", "items": {"type": "object", "required": ["evidence_id", "operator_id", "scope", "sample_count", "artifact_paths", "warnings"], "properties": {"evidence_id": {"type": "string", "pattern": "^(E[0-9]{4,}|standalone:[a-f0-9]{16})$"}, "operator_id": {"type": "string", "pattern": "^A[0-9]{3}$"}, "scope": {"type": "object"}, "sample_count": {"type": "integer", "minimum": 0}, "artifact_paths": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
    "evidence_relations": {"type": "array", "items": {"type": "object", "required": ["relation_id", "revision", "evidence_ids", "relation_type", "independence", "rationale", "status"], "properties": {"relation_id": {"type": "string", "pattern": "^REL[0-9]{4,}$"}, "revision": {"type": "integer", "minimum": 1}, "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{4,}$"}, "minItems": 2, "uniqueItems": true}, "relation_type": {"enum": ["corroborates", "duplicates", "refines", "localizes", "conditionalizes", "contradicts", "apparent_contradiction", "exception", "incomparable", "comparison_candidate", "unresolved"]}, "candidate_relation": {"enum": ["global_local_contrast", "parameter_contrast", "cross_evidence_comparison"]}, "independence": {"enum": ["high", "medium", "low", "unknown"]}, "rationale": {"type": "string", "minLength": 1}, "status": {"enum": ["candidate", "reviewed", "validated"]}}, "additionalProperties": true}},
    "unresolved_contradictions": {"type": "array", "items": {"type": "object", "required": ["title", "summary", "evidence_ids"], "properties": {"title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{4,}$"}, "minItems": 1}}, "additionalProperties": true}},
    "contradiction_assessment": {"type": "object", "required": ["status", "summary"], "properties": {"status": {"enum": ["not_assessed", "none_found", "found"]}, "summary": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "exploration_summary": {"type": "object", "required": ["stage", "attempted_analysis_signatures", "negative_results_preserved", "falsification_required"], "properties": {"stage": {"enum": ["discovery", "validation", "mixed"]}, "attempted_analysis_signatures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "negative_results_preserved": {"type": "boolean"}, "falsification_required": {"const": true}}, "additionalProperties": true},
    "notable_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "analysis_requests": {"type": "array", "items": {"$ref": "#/$defs/request"}},
    "recommended_next_analysis": {"type": "array", "items": {"type": "object", "required": ["source_id", "action", "purpose", "approval_status"], "properties": {"source_id": {"type": "string", "pattern": "^[FHQ][0-9]{4,}$"}, "action": {"type": "string", "minLength": 1}, "purpose": {"enum": ["characterize", "falsify", "control", "replicate"]}, "approval_status": {"const": "orchestrator_must_determine"}}, "additionalProperties": true}},
    "human_review_points": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "lifecycle": {"type": "object", "required": ["revision", "origin_round_id", "last_updated_round_id"], "properties": {"revision": {"type": "integer", "minimum": 1}, "origin_round_id": {"type": ["string", "null"]}, "last_updated_round_id": {"type": ["string", "null"]}}},
    "finding": {"allOf": [{"$ref": "#/$defs/lifecycle"}, {"type": "object", "required": ["finding_id", "title", "scientific_question", "analysis_context", "observation", "interpretation", "why_notable", "evidence_ids", "result_values", "warnings", "limitations", "status"], "properties": {"finding_id": {"type": "string", "pattern": "^F[0-9]{4,}$"}, "title": {"type": "string", "minLength": 1}, "scientific_question": {"type": "string", "minLength": 1}, "analysis_context": {"type": "object", "required": ["operator_id", "operator_name", "scope_mode", "sample_count"]}, "observation": {"type": "string", "minLength": 1}, "interpretation": {"type": "string", "minLength": 1}, "why_notable": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^(E[0-9]{4,}|standalone:[a-f0-9]{16})$"}, "minItems": 1}, "result_values": {"type": "object"}, "warnings": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["discovery", "validated", "refuted", "inconclusive", "negative"]}}, "additionalProperties": true}]},
    "hypothesis": {"allOf": [{"$ref": "#/$defs/lifecycle"}, {"type": "object", "required": ["hypothesis_id", "title", "claim", "supporting_evidence", "confidence", "falsification_status"], "properties": {"hypothesis_id": {"type": "string", "pattern": "^H[0-9]{4,}$"}, "title": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1}, "supporting_evidence": {"type": "array", "items": {"type": "string", "pattern": "^(E[0-9]{4,}|standalone:[a-f0-9]{16})$"}, "minItems": 1}, "confidence": {"enum": ["exploratory", "low", "low_to_medium", "medium", "medium_to_high", "high"]}, "falsification_status": {"enum": ["required", "planned", "tested_supported", "tested_refuted", "unavailable"]}}, "additionalProperties": true}]},
    "question": {"allOf": [{"$ref": "#/$defs/lifecycle"}, {"type": "object", "required": ["question_id", "title", "rationale", "deep_dive_potential", "agent_priority", "human_decision", "status", "evidence_ids", "target_group_ids", "operator_ids"], "properties": {"question_id": {"type": "string", "pattern": "^Q[0-9]{4,}$"}, "title": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "deep_dive_potential": {"type": "boolean"}, "agent_priority": {"enum": ["low", "medium", "high"]}, "human_decision": {"enum": ["unreviewed", "allow", "skip", "defer"]}, "status": {"enum": ["open", "in_progress", "answered", "closed", "skipped"]}, "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^(E[0-9]{4,}|standalone:[a-f0-9]{16})$"}}, "target_group_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "operator_ids": {"type": "array", "items": {"type": "string", "pattern": "^A[0-9]{3}$"}}}, "additionalProperties": true}]},
    "request": {"type": "object", "required": ["request_id", "revision", "question_id", "source_id", "action", "purpose", "status", "round_id"], "properties": {"request_id": {"type": "string", "pattern": "^REQ[0-9]{4,}$"}, "revision": {"type": "integer", "minimum": 1}, "question_id": {"type": "string", "pattern": "^Q[0-9]{4,}$"}, "source_id": {"type": "string", "pattern": "^[FH][0-9]{4,}$"}, "action": {"type": "string", "minLength": 1}, "purpose": {"enum": ["characterize", "falsify", "control", "replicate"]}, "status": {"enum": ["proposed", "accepted", "scheduled", "completed", "rejected"]}, "round_id": {"type": ["string", "null"]}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
