{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/interpretation.schema.json",
  "title": "CONDUCTOR v4 interpretation",
  "type": "object",
  "required": ["schema_version", "policy_version", "run_id", "interpretation_id", "evidence_index", "evidence_relations", "unresolved_contradictions", "exploration_summary", "notable_findings", "hypotheses", "recommended_next_analysis", "human_review_points", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "interpretation_id": {"type": "string", "minLength": 1},
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "operator_id", "scope", "sample_count", "artifact_paths", "warnings"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "operator_id": {"type": "string", "pattern": "^A[0-9]{3}$"},
          "scope": {"type": "object"},
          "sample_count": {"type": "integer", "minimum": 0},
          "artifact_paths": {"type": "array", "items": {"type": "string"}},
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "evidence_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation_id", "evidence_ids", "relation_type", "independence", "rationale", "status"],
        "properties": {
          "relation_id": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
          "relation_type": {"enum": ["corroborates", "duplicates", "refines", "localizes", "conditionalizes", "contradicts", "apparent_contradiction", "exception", "incomparable", "comparison_candidate", "unresolved"]},
          "independence": {"enum": ["high", "medium", "low", "unknown"]},
          "rationale": {"type": "string", "minLength": 1},
          "status": {"enum": ["candidate", "reviewed", "validated"]}
        },
        "additionalProperties": true
      }
    },
    "unresolved_contradictions": {"type": "array", "items": {"type": "object"}},
    "exploration_summary": {
      "type": "object",
      "required": ["stage", "attempted_analysis_signatures", "negative_results_preserved", "falsification_required"],
      "properties": {
        "stage": {"enum": ["discovery", "validation", "mixed"]},
        "attempted_analysis_signatures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "negative_results_preserved": {"type": "boolean"},
        "falsification_required": {"const": true}
      },
      "additionalProperties": true
    },
    "notable_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "title", "observation", "evidence_ids", "result_values", "warnings"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "result_values": {"type": "object"},
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "title", "target_group", "observation", "supporting_evidence", "contradicting_evidence", "evidence_independence", "alternative_explanations", "scope", "exceptions", "confidence", "confidence_rationale", "proposed_structural_implication", "recommended_next_analysis", "recommended_next_compounds", "human_review_points"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "target_group": {"type": ["string", "null"]},
          "observation": {"type": "string", "minLength": 1},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "contradicting_evidence": {"type": "array", "items": {"type": "string"}},
          "evidence_independence": {"type": "string", "minLength": 1},
          "alternative_explanations": {"type": "array", "items": {"type": "string"}},
          "scope": {"type": "array", "items": {"type": "string"}},
          "exceptions": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "minLength": 1},
          "confidence_rationale": {"type": "string", "minLength": 1},
          "proposed_structural_implication": {"type": "string"},
          "recommended_next_analysis": {"type": "array", "items": {"type": "string"}},
          "recommended_next_compounds": {"type": "array", "items": {"type": "string"}},
          "human_review_points": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "recommended_next_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_hypothesis_id", "action", "purpose", "approval_status"],
        "properties": {
          "source_hypothesis_id": {"type": "string"},
          "action": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["characterize", "falsify", "control", "replicate"]},
          "approval_status": {"const": "orchestrator_must_determine"}
        },
        "additionalProperties": true
      }
    },
    "human_review_points": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
