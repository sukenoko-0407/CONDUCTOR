{
  "schema_version": "2.0.0",
  "capability_id": "A005",
  "skill_name": "cs-analysis-multidescription-feature-model",
  "display_name": "Multi-Description feature model",
  "version": "0.2.0",
  "stage": "analysis",
  "family": "feature_model",
  "description": "Use when Claude Code needs to run Multi-Description feature model from CSV or compatible CONDUCTOR artifacts with a self-contained Pixi environment.",
  "cost": {
    "class": "high",
    "human_approval_required": false,
    "hpc_profile": "cpu64"
  },
  "applicability": {
    "status": "experimental",
    "platforms": [
      "linux-64",
      "win-64"
    ],
    "molecule_standardization": "out_of_scope"
  },
  "operator_id": "A005",
  "dependencies": [
    "description"
  ],
  "input_contract": [
    "endpoint_csv",
    "six_description_artifacts",
    "optional_clustering",
    "optional_global_model"
  ],
  "output": {
    "filename": "A005_multidescription_feature_model.csv",
    "report": "operator_report.html",
    "summary": "operator_summary.json",
    "manifest": "analysis_manifest.json"
  },
  "implementation": {
    "operator": "multidescription_feature_model"
  },
  "analysis_role": "multidescription_feature_model",
  "scope_support": [
    "global-model",
    "cluster-survey",
    "within-cluster"
  ],
  "approval_policy": "preauthorized_initial",
  "fixed_description_panel": [
    "D001",
    "D002",
    "D006",
    "D013",
    "D016",
    "D019"
  ],
  "default_parameters": {
    "role": "global-model",
    "random_seed": 61453,
    "min_local_samples": 30
  },
  "interpretation_profile": {
    "schema_version": "1.0.0", "profile_id": "IP-A005-1.0.0", "result_role": "model",
    "allowed_axes": ["favorable_signal", "context_deviation", "chemical_actionability", "independent_support", "follow_up_leverage"],
    "comparison_metrics": [
      {"name": "oof_rmse", "source": "best_rmse", "unit": "endpoint", "direction": "lower", "comparison_scope": "all"},
      {"name": "oof_r2", "source": "best_r2", "unit": null, "direction": "higher", "comparison_scope": "all"},
      {"name": "rmse_delta_vs_global", "source": "rmse_delta_vs_global", "unit": "endpoint", "direction": "lower", "comparison_scope": "global_local"}
    ],
    "primary_favorable_metric": null, "global_comparator": "required_for_local", "sibling_comparison": "supported", "standalone_insight": "conditional",
    "minimum_support": {"global": 30, "local": 30}, "null_result": "background",
    "anchors": {
      "favorable_signal": ["活性方向を示さない", "弱いfeature方向候補", "安定したfeature方向候補", "操作可能なfeatureと方向が明確"],
      "context_deviation": ["性能差なし", "軽度のLocal差", "GlobalとLocalで性能差が明確", "Localで予測可能性が質的に変化"],
      "chemical_actionability": ["feature不明", "広いfeature block", "少数の具体feature", "構造操作へ接続可能"],
      "independent_support": ["支持なし", "単一modelのみ", "foldまたは別表現で支持", "独立Operatorでも支持"],
      "follow_up_leverage": ["確認価値なし", "再CV可能", "外れ値・Local検証が明確", "少数の追加化合物で判断可能"]
    }
  },
  "conductor_request": {
    "schema_version": "1.0.0",
    "adapter": "multidescription_operator",
    "required_input_roles": [
      "dataset",
      "description"
    ],
    "unknown_parameters": "reject_by_skill_cli"
  }
}
