{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/interpretation.schema.json",
  "title": "CONDUCTOR 0.1.2 Interpretation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "round_id", "node_id", "title", "report_header", "executive_summary", "coverage_summary", "insights", "result_catalog", "review_manifest", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "supersedes": {"type": ["string", "null"], "pattern": "^N[0-9]{6}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "report_header": {"type": "object", "required": ["project", "endpoint", "higher_is_better", "endpoint_unit", "endpoint_transform", "completion"], "properties": {"project": {"type": "string"}, "endpoint": {"type": "string"}, "higher_is_better": {"type": "boolean"}, "endpoint_unit": {"type": ["string", "null"]}, "endpoint_transform": {"type": ["string", "null"]}, "completion": {"enum": ["complete", "partial", "blocked", "undetermined"]}}, "additionalProperties": false},
    "executive_summary": {"type": "string", "minLength": 1, "maxLength": 6000},
    "coverage_summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "insights": {"type": "array", "items": {"$ref": "#/$defs/insight"}},
    "result_catalog": {"type": "array", "items": {"$ref": "result_card.schema.json"}},
    "review_manifest": {"$ref": "interpretation_review_manifest.schema.json"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insight_id", "revision", "attention", "claim_kind", "title", "analysis_subject", "supporting_results", "comparison_results", "counter_results", "observation", "interpretation", "limitations", "recommended_followups", "fact_panel"],
      "properties": {
        "insight_id": {"type": "string", "pattern": "^INS[0-9]{6}$"},
        "revision": {"type": "integer", "minimum": 1},
        "attention": {"enum": ["pinned", "active", "watch", "background"]},
        "claim_kind": {"enum": ["single_scope_observation", "difference", "agreement", "contradiction", "negative_result", "coverage_gap"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "analysis_subject": {"$ref": "analysis_subject.schema.json"},
        "supporting_results": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "comparison_results": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "counter_results": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "observation": {"type": "string", "minLength": 1, "maxLength": 5000},
        "interpretation": {"type": "string", "minLength": 1, "maxLength": 5000},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "recommended_followups": {"type": "array", "items": {"type": "object", "required": ["title", "rationale"], "properties": {"title": {"type": "string"}, "rationale": {"type": "string"}}, "additionalProperties": false}},
        "fact_panel": {"type": "object"}
      }
    }
  }
}
