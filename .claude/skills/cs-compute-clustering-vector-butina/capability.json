{
  "schema_version": "1.0.0",
  "capability_id": "C005",
  "skill_name": "cs-compute-clustering-vector-butina",
  "display_name": "Vector Butina clustering",
  "version": "4.0.0",
  "stage": "grouping",
  "family": "description_vector",
  "grouping_kind": "description_vector",
  "description": "Use when Claude Code needs to apply Butina clustering to a numeric vector artifact produced by a Description Skill; this Skill does not accept SMILES or generate fingerprints internally.",
  "cost": {
    "class": "medium",
    "human_approval_required": false,
    "hpc_profile": "cpu64"
  },
  "applicability": {
    "status": "stable",
    "platforms": [
      "linux-64",
      "win-64"
    ],
    "molecule_standardization": "out_of_scope"
  },
  "default_wide_shallow": true,
  "wide_shallow_axis": "vector_similarity_partition",
  "wide_shallow_sources": {
    "description": [
      "D002"
    ]
  },
  "clustering_id": "C005",
  "default_parameters": {
    "min_cluster_size": 3,
    "metric": "jaccard",
    "similarity_threshold": 0.55
  },
  "dependencies": [
    "description"
  ],
  "input_contract": [
    "description_vector_csv"
  ],
  "output": {
    "membership": "cluster_membership.csv",
    "summary": "cluster_summary.csv"
  },
  "implementation": {
    "algorithm": "vector_butina"
  }
}
