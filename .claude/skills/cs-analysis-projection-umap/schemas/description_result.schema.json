{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/description_result.schema.json",
  "title": "Canonical Description Result",
  "type": "object",
  "required": ["document_type", "schema_version", "node_id", "capability_id", "payload", "row_count", "feature_count", "value_semantics", "natural_metric", "feature_columns", "quality_flags", "created_at"],
  "properties": {
    "document_type": {"const": "description_result"},
    "schema_version": {"const": "1.0.0"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "capability_id": {"type": "string", "pattern": "^D[0-9]{3}$"},
    "payload": {"type": "string", "pattern": "^[^/\\\\]+$"},
    "row_count": {"type": "integer", "minimum": 0},
    "feature_count": {"type": "integer", "minimum": 1},
    "value_semantics": {"enum": ["binary_fingerprint", "sparse_count", "dense_continuous", "dense_shape_moment", "dense_embedding"]},
    "natural_metric": {"enum": ["tanimoto", "cosine", "euclidean", "manhattan"]},
    "feature_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"value_semantics": {"const": "binary_fingerprint"}}}, "then": {"properties": {"natural_metric": {"const": "tanimoto"}}}},
    {"if": {"properties": {"value_semantics": {"const": "sparse_count"}}}, "then": {"properties": {"natural_metric": {"const": "cosine"}}}},
    {"if": {"properties": {"value_semantics": {"const": "dense_continuous"}}}, "then": {"properties": {"natural_metric": {"const": "euclidean"}}}},
    {"if": {"properties": {"value_semantics": {"const": "dense_shape_moment"}}}, "then": {"properties": {"natural_metric": {"const": "manhattan"}}}},
    {"if": {"properties": {"value_semantics": {"const": "dense_embedding"}}}, "then": {"properties": {"natural_metric": {"const": "cosine"}}}}
  ],
  "additionalProperties": false
}
