{
  "schema_version": "2.0.0",
  "capability_id": "A008",
  "skill_name": "cs-analysis-sali",
  "display_name": "Extended structure-activity landscape index",
  "version": "0.2.0",
  "stage": "analysis",
  "family": "landscape",
  "description": "Use when Claude Code needs to evaluate local property-landscape roughness and smoothness with representation-aware SALI and preserve high-SALI cliff pairs for CONDUCTOR Interpretation.",
  "cost": {
    "class": "medium",
    "human_approval_required": false,
    "hpc_profile": "cpu64"
  },
  "applicability": {
    "status": "stable",
    "platforms": [
      "linux-64",
      "win-64"
    ],
    "molecule_standardization": "out_of_scope"
  },
  "operator_id": "A008",
  "dependencies": [
    "description"
  ],
  "input_contract": [
    "endpoint_csv",
    "description"
  ],
  "output": {
    "filename": "A008_sali.csv",
    "report": "operator_report.html",
    "summary": "operator_summary.json",
    "manifest": "analysis_manifest.json"
  },
  "implementation": {
    "operator": "sali"
  },
  "analysis_role": "sali",
  "scope_support": [
    "global",
    "within-cluster",
    "between-clusters"
