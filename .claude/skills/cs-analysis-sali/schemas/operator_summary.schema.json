{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/operator_summary.schema.json",
  "title": "CONDUCTOR operator summary",
  "type": "object",
  "required": ["schema_version", "result_ref", "node_id", "attempt_id", "operator_id", "run_id", "round_id", "scope", "scope_context", "sample_count", "endpoint", "metric", "headline", "key_metrics", "limitations", "warnings", "source_nodes", "primary_artifact", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "result_ref": {"type": "string", "pattern": "^N[0-9]{6}@ATT[0-9]{4}(/C[0-9]{6})?$"},
    "node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "attempt_id": {"type": "string", "pattern": "^ATT[0-9]{4}$"},
    "operator_id": {"type": "string", "pattern": "^A[0-9]{3}$"},
    "run_id": {"type": "string", "minLength": 1},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "scope": {"type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["global", "within-cluster", "between-clusters", "projection-fit", "cluster-overlay", "global-model", "cluster-survey"]}, "target_cluster_id": {"type": ["string", "null"]}, "comparison_cluster_id": {"type": ["string", "null"]}}, "additionalProperties": true},
    "scope_context": {"type": "object", "required": ["description_node_ids", "clustering_node_ids", "cluster_ids"], "properties": {"description_node_ids": {"type": "array", "items": {"type": "string", "pattern": "^N[0-9]{6}$"}, "uniqueItems": true}, "clustering_node_ids": {"type": "array", "items": {"type": "string", "pattern": "^N[0-9]{6}$"}, "uniqueItems": true}, "cluster_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{6}$"}, "uniqueItems": true}}, "additionalProperties": true},
    "sample_count": {"type": "integer", "minimum": 0},
    "endpoint": {"type": "object", "required": ["column", "higher_is_better"], "properties": {"column": {"type": "string", "minLength": 1}, "higher_is_better": {"type": "boolean"}}, "additionalProperties": true},
    "metric": {"type": ["string", "null"]},
    "headline": {"type": "string", "minLength": 1, "maxLength": 1000},
    "key_metrics": {"type": "object"},
    "top_records": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "source_nodes": {"type": "array", "items": {"type": "string", "pattern": "^N[0-9]{6}$"}, "uniqueItems": true},
    "primary_artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": true},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
