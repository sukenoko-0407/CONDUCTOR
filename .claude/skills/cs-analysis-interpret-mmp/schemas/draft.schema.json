{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/mmp_interpretation_draft.schema.json",
  "title": "Read-only MMP interpretation draft",
  "type": "object",
  "required": ["title", "executive_summary", "observations", "human_guidance"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "executive_summary": {"type": "string", "minLength": 1, "maxLength": 5000},
    "observations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "category", "observation", "interpretation", "limitations"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "category": {"enum": ["variance_collapse", "cluster_specific", "direction_reversal", "coverage", "negative_result"]},
          "observation": {"type": "string", "minLength": 1, "maxLength": 5000},
          "interpretation": {"type": "string", "minLength": 1, "maxLength": 5000},
          "evidence": {"type": "array", "items": {"type": "string", "maxLength": 500}, "maxItems": 20},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}, "minItems": 1, "maxItems": 20}
        },
        "additionalProperties": false
      }
    },
    "human_guidance": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["title", "prompt"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "prompt": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
