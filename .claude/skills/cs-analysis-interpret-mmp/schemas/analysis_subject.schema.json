{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/mmp_interpretation_analysis_subject.schema.json",
  "title": "MMP interpretation source subject",
  "type": "object",
  "required": ["mmp_node_id", "clustering_node_ids", "cluster_ids"],
  "properties": {
    "mmp_node_id": {"type": "string", "pattern": "^N[0-9]{6}$"},
    "clustering_node_ids": {"type": "array", "items": {"type": "string", "pattern": "^N[0-9]{6}$"}, "uniqueItems": true},
    "cluster_ids": {"type": "array", "items": {"type": "string", "pattern": "^C[0-9]{6}$"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
