{
  "schema_version": "2.0.0",
  "capability_id": "A011",
  "skill_name": "cs-analysis-cluster-enrichment",
  "display_name": "Cluster activity enrichment",
  "version": "0.1.8",
  "stage": "analysis",
  "family": "cluster_profile",
  "description": "Use when Claude Code needs to run Cluster activity enrichment from CSV or compatible CONDUCTOR artifacts with a self-contained Pixi environment.",
  "cost": {
    "class": "low",
    "human_approval_required": false,
    "hpc_profile": "cpu64"
  },
  "applicability": {
    "status": "stable",
    "platforms": [
      "linux-64",
      "win-64"
    ],
    "molecule_standardization": "out_of_scope"
  },
  "operator_id": "A011",
  "dependencies": [
    "clustering"
  ],
  "input_contract": [
    "endpoint_csv",
    "clustering"
  ],
  "output": {
    "filename": "A011_cluster_enrichment.csv",
    "report": "operator_report.html",
    "summary": "operator_summary.json",
    "manifest": "analysis_manifest.json"
  },
  "implementation": {
    "operator": "cluster_enrichment"
  },
  "analysis_role": "cluster_enrichment",
  "scope_support": [
    "global",
    "within-cluster"
  ],
  "default_parameters": {
    "high_quantile": 0.8,
    "low_quantile": 0.2
  },
  "interpretation_profile": {
    "schema_version": "2.0.0", "profile_id": "IP-A011-2.0.0", "result_role": "activity_signal",
    "allowed_axes": ["favorable_evidence", "context_contrast", "evidence_specificity"],
    "comparison_metrics": [
      {"name": "favorable_fraction", "source": "selected_favorable_fraction|global_favorable_fraction", "unit": "fraction", "direction": "higher", "comparison_scope": "all"},
      {"name": "odds_ratio", "source": "selected_odds_ratio", "unit": null, "direction": "higher", "comparison_scope": "global_local"},
      {"name": "fisher_pvalue", "source": "selected_fisher_pvalue", "unit": null, "direction": "lower", "comparison_scope": "global_local"},
      {"name": "median_shift_vs_global", "source": "selected_median_shift_vs_global", "unit": "endpoint", "direction": "favorable", "comparison_scope": "global_local"}
    ],
    "primary_favorable_metric": "favorable_fraction", "global_comparator": "required_for_local", "sibling_comparison": "supported", "standalone_insight": "conditional",
    "minimum_support": {"global": 10, "local": 5}, "null_result": "background",
    "anchors": {
      "favorable_evidence": ["濃縮なし", "弱い濃縮", "統計と効果が限定scopeで明確", "強く一貫した濃縮"],
      "context_contrast": ["Globalとの差なし", "軽度の差", "明確なLocal濃縮", "兄弟Clusterと反対方向の局在"],
      "evidence_specificity": ["Cluster由来不明", "広いCluster特性", "特定seriesに接続", "具体的な構造要素へ接続"]
    }
  },
  "conductor_request": {
    "schema_version": "1.0.0",
    "adapter": "standard_operator",
    "required_input_roles": [
      "dataset"
    ],
    "unknown_parameters": "reject_by_skill_cli"
  }
}
