{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/analysis_profile.schema.json",
  "title": "CONDUCTOR analysis profile",
  "type": "object",
  "required": ["schema_version", "profile_id", "managed_by", "basic_compute", "initial_exploration", "additional_exploration", "description_semantics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "managed_by": {"const": "human"},
    "description": {"type": "string"},
    "basic_compute": {
      "type": "object",
      "required": ["description_capabilities", "direct_structure_grouping", "vector_grouping_capabilities", "vector_grouping_representations", "conditional_grouping", "high_cost_bundle"],
      "additionalProperties": false,
      "properties": {
        "description_capabilities": {"$ref": "#/$defs/capabilityList"},
        "direct_structure_grouping": {"$ref": "#/$defs/capabilityList"},
        "vector_grouping_capabilities": {"$ref": "#/$defs/capabilityList"},
        "vector_grouping_representations": {"$ref": "#/$defs/capabilityList"},
        "conditional_grouping": {"$ref": "#/$defs/capabilityList"},
        "high_cost_bundle": {"$ref": "#/$defs/capabilityList"}
      }
    },
    "initial_exploration": {
      "type": "object",
      "required": ["description_master_panel", "global_operator_capabilities", "local_operator_capabilities", "representative_groups_per_grouping", "representative_roles"],
      "properties": {
        "description_master_panel": {"$ref": "#/$defs/capabilityList"},
        "global_operator_capabilities": {"$ref": "#/$defs/capabilityList"},
        "local_operator_capabilities": {"$ref": "#/$defs/capabilityList"},
        "representative_groups_per_grouping": {"type": "integer", "minimum": 1, "maximum": 10},
        "representative_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "additional_exploration": {
      "type": "object",
      "required": ["stratify_by", "sampling"],
      "properties": {
        "stratify_by": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "sampling": {"const": "seeded_balanced_without_replacement"}
      },
      "additionalProperties": false
    },
    "description_semantics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value_semantics", "natural_metric"],
        "properties": {
          "value_semantics": {"type": "string", "minLength": 1},
          "natural_metric": {"enum": ["tanimoto", "cosine", "euclidean", "manhattan"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "capabilityList": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(\\*|[DCAIO][0-9]{3})$"},
      "uniqueItems": true
    }
  }
}
