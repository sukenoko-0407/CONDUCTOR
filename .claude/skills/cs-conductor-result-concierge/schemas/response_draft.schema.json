{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/concierge-response-draft.schema.json",
  "title": "CONDUCTOR concierge response draft",
  "type": "object",
  "required": ["title", "request_summary", "answer_markdown", "focus_ids", "source_paths", "figures", "limitations", "suggested_next_round_prompt"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "request_summary": {"type": "string", "minLength": 1},
    "answer_markdown": {"type": "string", "minLength": 1},
    "focus_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "figures": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["figure_id", "kind", "title", "x", "y", "x_label", "y_label", "caption", "source_paths"],
        "properties": {
          "figure_id": {"type": "string", "pattern": "^FIG[0-9]{3,}$"},
          "kind": {"enum": ["bar", "line", "scatter"]},
          "title": {"type": "string", "minLength": 1},
          "x": {"type": "array", "minItems": 1, "maxItems": 5000},
          "y": {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 5000},
          "x_label": {"type": "string"},
          "y_label": {"type": "string"},
          "caption": {"type": "string"},
          "source_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "suggested_next_round_prompt": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
