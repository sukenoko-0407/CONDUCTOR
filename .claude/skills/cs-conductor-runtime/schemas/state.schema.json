{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/state.schema.json",
  "title": "CONDUCTOR State",
  "type": "object",
  "required": ["schema_version", "conductor_version", "revision", "run", "round_control", "orchestration_control", "counters", "execution_graph", "indices", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "conductor_version": {"const": "0.1.1"},
    "revision": {"type": "integer", "minimum": 0},
    "run": {"type": "object", "required": ["run_id", "project", "input", "input_hash", "endpoint", "higher_is_better", "parallel_limit"], "properties": {"run_id":{"type":"string","minLength":1},"project":{"type":"string","minLength":1},"input":{"type":"string","minLength":1},"input_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"endpoint":{"type":"string","minLength":1},"higher_is_better":{"type":"boolean"},"parallel_limit":{"type":"integer","minimum":1}}, "additionalProperties":true},
    "round_control": {"type":"object","required":["active_round_id","next_round_number","rounds"],"properties":{"active_round_id":{"type":["string","null"]},"next_round_number":{"type":"integer","minimum":1},"rounds":{"type":"array","items":{"type":"object"}}},"additionalProperties":true},
    "orchestration_control": {"type":"object","required":["lease"],"properties":{"lease":{"type":"object"}},"additionalProperties":true},
    "counters": {"type":"object","required":["description_node","clustering_node","analysis_node","interpretation_node","cluster","insight","action"],"additionalProperties":{"type":"integer","minimum":0}},
    "execution_graph": {"type":"object","required":["nodes","edges"],"properties":{"nodes":{"type":"array","items":{"$ref":"#/$defs/node"}},"edges":{"type":"array","items":{"type":"object","required":["source","target"],"properties":{"source":{"type":"string"},"target":{"type":"string"}},"additionalProperties":false}}},"additionalProperties":false},
    "indices": {"type":"object"},
    "created_at": {"type":"string","format":"date-time"},
    "updated_at": {"type":"string","format":"date-time"}
  },
  "$defs": {
    "node": {"type":"object","required":["node_id","stage","capability_id","skill_name","round_id","requested_round_id","execution_round_id","phase","dependencies","parameters","analysis_signature","status","execution_attempts"],"properties":{"node_id":{"type":"string","pattern":"^N[DCAI][0-9]{6}$"},"stage":{"enum":["description","clustering","analysis","interpretation"]},"capability_id":{"type":"string","pattern":"^[DCAI][0-9]{3}$"},"skill_name":{"type":"string"},"round_id":{"type":"string","pattern":"^RND[0-9]{4}$"},"requested_round_id":{"type":"string","pattern":"^RND[0-9]{4}$"},"execution_round_id":{"type":["string","null"],"pattern":"^RND[0-9]{4}$"},"phase":{"enum":["basic_compute","initial_global","initial_local","additional_exploration","deep_dive","human_directed"]},"dependencies":{"type":"array","items":{"type":"string"},"uniqueItems":true},"parameters":{"type":"object"},"analysis_signature":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"enum":["pending","running","succeeded","failed","unavailable","not_applicable","skipped","waived","stale","deferred"]},"execution_attempts":{"type":"array","items":{"type":"object"}},"current_attempt_id":{"type":["string","null"]}},"additionalProperties":true}
  },
  "additionalProperties":true
}
