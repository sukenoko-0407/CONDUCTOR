{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.local/schemas/execution_event.schema.json",
  "title": "CONDUCTOR execution event",
  "type": "object",
  "required": ["schema_version", "project", "run_id", "round_id", "node_id", "attempt_id", "capability_id", "skill_name", "status", "input_hash", "config_hash", "configuration", "artifacts", "warnings", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "project": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "round_id": {"type": "string", "pattern": "^RND[0-9]{4}$"},
    "node_id": {"type": "string", "pattern": "^N[DCAI][0-9]{6}$"},
    "attempt_id": {"type": "string", "pattern": "^ATT[0-9]{4}$"},
    "capability_id": {"type": "string", "pattern": "^[DCAI][0-9]{3}$"},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"},
    "status": {"enum": ["succeeded", "failed", "skipped", "not_applicable", "unavailable"]},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "configuration": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
