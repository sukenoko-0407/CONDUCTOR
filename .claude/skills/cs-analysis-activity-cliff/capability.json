{
  "schema_version": "2.0.0",
  "capability_id": "A009",
  "skill_name": "cs-analysis-activity-cliff",
  "display_name": "Activity cliff detection",
  "version": "0.1.6",
  "stage": "analysis",
  "family": "landscape",
  "description": "Use when Claude Code needs to run Activity cliff detection from CSV or compatible CONDUCTOR artifacts with a self-contained Pixi environment.",
  "cost": {
    "class": "medium",
    "human_approval_required": false,
    "hpc_profile": "cpu64"
  },
  "applicability": {
    "status": "stable",
    "platforms": [
      "linux-64",
      "win-64"
    ],
    "molecule_standardization": "out_of_scope"
  },
  "operator_id": "A009",
  "dependencies": [],
  "input_contract": [
    "endpoint_csv"
  ],
  "output": {
    "filename": "A009_activity_cliff.csv",
    "report": "operator_report.html",
    "summary": "operator_summary.json",
    "manifest": "analysis_manifest.json"
  },
  "implementation": {
    "operator": "activity_cliff"
  },
  "analysis_role": "activity_cliff",
  "scope_support": [
    "global",
    "within-cluster",
    "between-clusters"
  ],
  "internal_representation": {
    "kind": "morgan",
    "radius": 2,
    "n_bits": 2048,
    "metric": "tanimoto"
  },
  "default_parameters": {
    "similarity_threshold": 0.8,
    "activity_delta_threshold": 1.0,
    "max_pairs": 200000,
    "random_seed": 61453
  },
  "conductor_request": {
    "schema_version": "1.0.0",
    "adapter": "standard_operator",
    "required_input_roles": [
      "dataset"
    ],
    "unknown_parameters": "reject_by_skill_cli"
  }
}
